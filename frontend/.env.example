# Copy to .env.development / .env.production and fill in real values.
# Vite only exposes vars prefixed VITE_ to client code - see constants.ts.

# Backend origin. If unset, constants.ts falls back to a hostname-based guess
# (localhost -> http://127.0.0.1:8080, otherwise the deployed Render URL).
VITE_API_BASE_URL=http://127.0.0.1:8080

# Firebase Web config (see firebase.ts). These are safe to expose client-side -
# Firebase's web apiKey is not a secret; access is controlled by Firebase
# Security Rules and API key restrictions in Google Cloud Console, not by
# hiding this value. Get these from Firebase Console > Project Settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
